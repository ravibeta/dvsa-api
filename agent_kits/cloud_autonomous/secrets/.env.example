# Cloud Autonomous runner — environment configuration EXAMPLE.
#
# Copy to `.env` (kept out of git) or provide these via your secrets manager /
# Kubernetes Secret. This file documents NAMES ONLY — never commit real values.

# Bearer token required on POST /run. If unset, auth is DISABLED (local dev only).
DVSA_API_KEY=

# External model endpoint (mocked in tests; the offline runner uses a mock adapter).
MODEL_ENDPOINT=

# Default output storage target. Non-remote values are treated as a local dir.
# Examples: s3://dvsa-runs   gs://dvsa-runs   file:///var/dvsa/runs   ./runs
STORAGE_BUCKET=

# Max concurrent runs handled by one runner instance.
RUNNER_MAX_PARALLELISM=4

# Retry behaviour for a single run.
RUNNER_RETRY_ATTEMPTS=3
RUNNER_RETRY_BACKOFF_S=0.05

# Pinned inference model version recorded in every detection's provenance.
MODEL_VERSION=mock-detector-1.0.0

# Log verbosity for structured JSON logs.
AGENT_KITS_LOG_LEVEL=INFO
