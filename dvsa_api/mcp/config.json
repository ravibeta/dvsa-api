{
  "server": {
    "name": "dvsa-mcp-server",
    "version": "1.0.0",
    "protocolVersion": "2024-11-05",
    "description": "DVSA-API drone video analytics exposed via Model-Context-Protocol."
  },
  "transport": {
    "type": "stdio",
    "command": "python",
    "args": ["scripts/mcp_server_run.py"]
  },
  "auth": {
    "type": "none",
    "note": "Optional bearer auth for HTTP transport via MCP_SERVER_API_KEY env var; stdio transport is local-trust."
  },
  "tools": [
    "dvsa.detect_anomalies",
    "dvsa.run_reasoning",
    "dvsa.extract_features",
    "dvsa.get_tracks",
    "dvsa.get_frames"
  ],
  "resources": {
    "schemes": ["dvsa://"],
    "templates": [
      "dvsa://frames/{id}",
      "dvsa://tracks/{id}",
      "dvsa://sensor/{id}"
    ],
    "data_root": "mcp/resource_data",
    "api_base_env": "MCP_DVSA_API_BASE"
  }
}
